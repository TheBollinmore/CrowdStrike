defineTable(name="byA", query={#event_simpleName=ProcessRollup2 event_platform=Win FileName=* ParentBaseFileName=* | child := lower(FileName) | groupBy([child], function=count(as=n_a), limit=max)}, include=[child, n_a])
| defineTable(name="byB", query={#event_simpleName=ProcessRollup2 event_platform=Win FileName=* ParentBaseFileName=* | parent := lower(ParentBaseFileName) | groupBy([parent], function=count(as=n_b), limit=max)}, include=[parent, n_b])
| defineTable(name="tot", query={#event_simpleName=ProcessRollup2 event_platform=Win FileName=* ParentBaseFileName=* | count(as=n_total) | one := "1"}, include=[one, n_total])
| #event_simpleName=ProcessRollup2 event_platform=Win FileName=* ParentBaseFileName=*
| child := lower(FileName) | parent := lower(ParentBaseFileName)
| !in(child, values=["conhost.exe","werfault.exe","wermgr.exe"])
| cdir := lower(FilePath)
| replace("^\\\\device\\\\harddiskvolume\\d+", with="", field=cdir, as=cdir)
| replace("\\\\[^\\\\]+\\.exe$", with="", field=cdir, as=cdir)
| replace("_[0-9a-f]{16}_.*$", with="", field=cdir, as=cdir)
| replace("^\\\\users\\\\[^\\\\]+", with="<userprofile>", field=cdir, as=cdir)
| replace("^\\\\documents and settings\\\\[^\\\\]+", with="<userprofile>", field=cdir, as=cdir)
| replace("\\\\[\\w-]+\\.tmp.*$", with="<tmpdir>", field=cdir, as=cdir)
| replace("\\\\temp\\\\.*$", with="<temp>", field=cdir, as=cdir)
| replace("\\\\temp$", with="<temp>", field=cdir, as=cdir)
| replace("\\d+\\.\\d+\\.\\d+\\.\\d+", with="<ver>", field=cdir, as=cdir)
| replace("\\d+\\.\\d+\\.\\d+", with="<ver>", field=cdir, as=cdir)
| replace("<ver>_\\d+", with="<ver>", field=cdir, as=cdir)
| replace("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", with="<uuid>", field=cdir, as=cdir)
| replace("[0-9a-f]{32,}", with="<hex>", field=cdir, as=cdir)
| replace("\\d{5,}", with="<num>", field=cdir, as=cdir)
| groupBy([child, parent], function=[count(as=n_ab), count(aid, distinct=true, as=hosts), collect([cdir], limit=3), collect([GrandParentBaseFileName], limit=3)], limit=max)
| n_ab <= 5
| match(table="byA", field=child, column=child, strict=true)
| match(table="byB", field=parent, column=parent, strict=true)
| one := "1" | match(table="tot", field=one, column=one, strict=true)
| n_b >= 500 | n_a >= 1000
| p_a_given_b := n_ab / n_b | p_b_given_a := n_ab / n_a
| lift_ab := (n_ab * n_total) / (n_a * n_b)
| p_a_given_b := format("%.6f", field=[p_a_given_b]) | p_b_given_a := format("%.6f", field=[p_b_given_a]) | lift_ab := format("%.4f", field=[lift_ab])
| select([child, parent, GrandParentBaseFileName, cdir, n_ab, n_a, n_b, hosts, p_a_given_b, p_b_given_a, lift_ab])
| sort(lift_ab, order=asc, type=number, limit=200)
