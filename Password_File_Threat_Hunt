#event_simpleName=/FileWritten$/ OR #event_simpleName=/^(NewExecutableWritten|NewScriptWritten|PackedExecutableWritten|RegistryHiveFileWritten|FileCreateInfo|FileRenameInfo|MotwWritten)$/
| event_platform=Win TargetFileName=*
| fp := lower(TargetFileName)
| regex("[\\\\/](?<fn>[^\\\\/]+)$", field=fp)
// cheap prefilter — superset of every category below
| fn=/pass|cred|login|logon|account|secret|unattend|sysprep|ntds|id_rsa|id_ed25519|id_ecdsa|id_dsa|\.kdbx|\.kdb$|psafe3|1pif|opvault|agilekeychain|pgpass|htpasswd|tnsnames|sqlnet|groups\.xml|\.(ppk|pem|pfx|p12|key|rdg|rdp|ovpn|vnc|vmem)$|my\.cnf|mylogin|netrc|npmrc|pypirc|git-credentials|^(web|app)\.config$|appsettings|^\.env|wp-config|settings\.py|database\.yml|config\.php|^(sam|system|security)$|lsass.*\.dmp$|services\.xml|scheduledtasks\.xml|datasources\.xml|printers\.xml|drives\.xml/
| case {
    fn=/pass(word|wd|wort)?s?([^a-z].*)?\.(txt|docx?|xlsx?|csv|rtf|one|md|json|ini|cfg|conf)$/ | category := "password_doc";
    fn=/cred(ential)?s?([^a-z].*)?\.(txt|docx?|xlsx?|csv|json|xml)$/ | category := "cred_doc";
    fn=/(login|logon|account)s?([^a-z].*)?\.(txt|docx?|xlsx?|csv)$/ | category := "login_doc";
    fn=/\.(kdbx|kdb|psafe3|1pif|opvault|agilekeychain)$/ | category := "pw_manager_vault";
    fn=/^(id_rsa|id_ed25519|id_ecdsa|id_dsa)$|\.(ppk|pem|pfx|p12|key)$/ | category := "private_key";
    fn=/^\.?(my\.cnf|mylogin\.cnf|pgpass|netrc|npmrc|pypirc|git-credentials)$/ | category := "cli_cred_file";
    fn=/^(web\.config|app\.config|appsettings.*\.json|\.env.*|wp-config\.php|settings\.py|database\.yml|secrets\.ya?ml|credentials\.ya?ml|config\.php|\.htpasswd|tnsnames\.ora|sqlnet\.ora)$/ | category := "app_config";
    fn=/^(unattend\.xml|sysprep\.xml|sysprep\.inf|autounattend\.xml|groups\.xml|services\.xml|scheduledtasks\.xml|datasources\.xml|printers\.xml|drives\.xml)$/ | category := "deploy_gpp_xml";
    fn=/^(ntds\.dit|sam|system|security)$|lsass.*\.dmp$|\.vmem$/ | category := "cred_dump";
    fn=/\.(rdg|rdp|ovpn|vnc)$/ | category := "remote_access_profile";
    * | category := "none" }
| category != "none"
| !fp=/\\windows\\winsxs\\|\\windows\\servicing\\|\\windows\\microsoft\.net\\|\\\$winreagent\\|\\program files\\|\\programdata\\microsoft\\|\\appdata\\local\\temp\\|node_modules|\\downloads\\cpub-[^\\]*\.rdp$/
| groupBy([category, ComputerName, ContextBaseFileName, fp], function=[count(as=events), collect([#event_simpleName], limit=3), min(@timestamp, as=first_seen), max(@timestamp, as=last_seen)], limit=max)
| first_seen := formatTime("%Y-%m-%d %H:%M", field=first_seen, timezone=UTC) | last_seen := formatTime("%Y-%m-%d %H:%M", field=last_seen, timezone=UTC)
| sort(events, order=desc, limit=1000)
